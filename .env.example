# Copy to .env and fill in. Never commit .env.

# Backend
APP_NAME=coursecompass-api
APP_ENV=local
PORT=8080
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=
CLERK_SECRET_KEY=
LLM_PROVIDER=
LLM_API_KEY=

# Cloud Run deploy (optional; also passed as shell env)
# GCP_PROJECT_ID=
# GCP_REGION=us-central1
# SERVICE_NAME=coursecompass-api

# Frontend variables live in frontend/.env.example (Vite only reads env
# files from the frontend/ folder).
