# Copy to .env and fill in. Never commit .env.

# Backend
APP_NAME=coursecompass-api
APP_ENV=local
PORT=8080
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=
CLERK_SECRET_KEY=
# Session JWT verify (pick one path):
# CLERK_PUBLISHABLE_KEY=pk_test_...   # derives JWKS + issuer
# CLERK_JWKS_URL=https://YOUR.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://YOUR.clerk.accounts.dev
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...  # optional networkless PEM
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173,https://course-compass-six.vercel.app

# Vertex AI Gemini (orchestration LLM)
LLM_PROVIDER=vertex
LLM_MODEL=gemini-2.5-flash
GCP_PROJECT_ID=coursecompass-509519
GCP_LOCATION=us-central1
# LLM_API_KEY is unused for Vertex (uses Application Default Credentials)
LLM_API_KEY=

# Vertex embeddings (syllabus_chunks.embedding is vector(768))
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Cloud Run deploy (optional; also passed as shell env)
# GCP_REGION=us-central1
# SERVICE_NAME=coursecompass-api

# Frontend variables live in frontend/.env.example (Vite only reads env
# files from the frontend/ folder).
