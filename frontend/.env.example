# Copy to .env.local (git ignores it) and fill in.
# Vite only exposes variables that start with VITE_ to the browser, so never
# put secret keys here. The Clerk publishable key is safe to expose.

# Leave empty to run in dev mode with a fake signed-in user.
VITE_CLERK_PUBLISHABLE_KEY=

# Backend URL, e.g. http://localhost:8000. Empty = same origin.
VITE_API_BASE_URL=

# true = use sample responses instead of calling the backend.
VITE_USE_MOCK_API=true

# Dev mode only: seed student to act as for transcript uploads, sent as
# X-Dev-Student-Id. The backend ignores it outside local/staging/test.
# user_3K1pFAxQfqDz2PPIyQtCuhCoMWO = just started
# user_3K1pC0YksFOD8HW1dIiz4ITDt90 = nearly done
VITE_DEV_STUDENT_ID=
